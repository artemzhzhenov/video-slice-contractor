{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.video.local/performance_track.json",
  "title": "PERFORMANCE_TRACK — continuous control channels per frame (ADR-0002 D8)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "shot", "channel_vocabulary_version", "fps", "frames"],
  "properties": {
    "schema_version": { "$ref": "common.json#/$defs/schema_version" },
    "shot": { "$ref": "common.json#/$defs/shot_ref" },
    "channel_vocabulary_version": { "type": "integer", "minimum": 1 },
    "fps": { "const": 24 },
    "frames": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["frame", "socket", "channels"],
        "properties": {
          "frame": { "type": "integer", "minimum": 1001 },
          "socket": {
            "type": "object", "additionalProperties": false,
            "required": ["position_m", "quaternion", "scale"],
            "properties": {
              "position_m": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
              "quaternion": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number", "minimum": -1, "maximum": 1 } },
              "scale": { "type": "number", "exclusiveMinimum": 0 }
            }
          },
          "channels": {
            "type": "object",
            "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
            "additionalProperties": { "type": "number", "minimum": -1, "maximum": 1 }
          },
          "editorial": {
            "type": "object", "additionalProperties": false,
            "properties": {
              "emotion": { "type": "string" },
              "emotion_intensity": { "type": "number", "minimum": 0, "maximum": 1 },
              "gaze_target": { "type": "string" }
            }
          },
          "gaze": {
            "description": "ADR-0002 amendment 2026-09-30 (vocabulary v2): the point the character looks at, in the socket's local frame, metres; every head aims each of its own eyes at it",
            "type": "object", "additionalProperties": false,
            "required": ["target_m", "source"],
            "properties": {
              "target_m": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
              "source": { "enum": ["LOOK_AT", "CAMERA", "NAMED_TARGET", "FAR"] }
            }
          }
        }
      }
    }
  },
  "if": { "properties": { "channel_vocabulary_version": { "minimum": 2 } } },
  "then": { "properties": { "frames": { "items": { "required": ["gaze"] } } } }
}
