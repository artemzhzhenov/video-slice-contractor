# secrets and local config
.env
.env.*
*.pem
*.key
config/local*

# never commit child imagery or derived personal data
uploads/
raw_photos/
derivatives/
customer_data/
*.jpg
*.jpeg
*.png
*.heic

# python / node
__pycache__/
*.pyc
.venv/
node_modules/

# os / editor
.DS_Store
.vscode/
.idea/

# claude code local
CLAUDE.local.md
# the agent's browser session output — may hold account pages
.playwright-mcp/
.claude/settings.local.json

# Phase 0.5 slice — renders and Blender backups are never committed
slice/**/renders*/
*.blend1
*.exr
# regenerable by slice/scene_template.py (REBUILD.md step 3); real asset scenes are archived, this one is not
benchmarks/**/template.blend
# The slice package (slice/package.py): its heavy files — renders, per-frame exports, Alembic — live in the archive
# (the manifest's offline part); its light JSON (exports, render and bundle manifests, reports) is in the manifest's
# committed part and must be in git, or `package.py verify` fails on a clean checkout (CI red 2026-09-29 — 10-25: the
# directories below were ignored whole). Ignore the contents, not the directories, so the JSON can be re-included.
benchmarks/**/renders*/**
benchmarks/**/shots/*/exports/**
!benchmarks/**/renders*/**/
!benchmarks/**/shots/*/exports/**/
!benchmarks/**/shots/*/renders/**/*.json
!benchmarks/**/shots/*/exports/*.json

# handoff guard: files that could carry credentials never enter git (session-handoff rule).
# Tracked schema/fixture names that merely contain "token" stay allowed explicitly.
access.md
*secret*
*token*
credentials*
*credentials*
!schemas/delivery_token.json
!fixtures/delivery_token/
!fixtures/_invalid/delivery_token/
!fixtures/_invalid/delivery_token/*
!fixtures/delivery_token/*
